# ---------------------------------------------------------------------------
# LIWM: private user data must NEVER enter version control.
# The real profile lives in ~/.liwm (or %USERPROFILE%\.liwm), outside any repo.
# These rules exist as defence-in-depth in case someone points LIWM_HOME at a
# repository directory, or copies a profile in for debugging.
# ---------------------------------------------------------------------------
.liwm/
liwm-home/
**/user.json
**/metrics.json
**/runtime_context.json
**/personal-strategy.json
**/promoted-rules.json
events/
sessions/
backups/
logs/
projects/*/intent.json
projects/*/decisions.json
projects/*/feedback.json
*.liwm-export.json
*.liwm-profile.json

# Explicitly re-include the repository's own fixtures, examples and schemas,
# which are synthetic and safe to publish.
!examples/**/user.json
!examples/**/metrics.json
!examples/**/runtime_context.json
!tests/fixtures/**
!schemas/**

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
scratch/
tmp/
*.tmp
*.log

# Pasted session transcripts. One of these was swept into a commit by `git add
# -A`: 264KB of conversation and absolute machine paths, in a public repo.
*local-command-caveat*.txt
dist1/
dist2/
