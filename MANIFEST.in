include LICENSE README.md CHANGELOG.md ROADMAP.md ARCHITECTURE.md RELEASE_CHECKLIST.md
include CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md PRIVACY.md THREAT_MODEL.md .gitignore pyproject.toml
include INSTALL_PROMPT.md UPDATE_PROMPT.md UNINSTALL_PROMPT.md
recursive-include adapters *.md
recursive-include docs *.md
recursive-include schemas *.json
recursive-include skills *.md
recursive-include tests *.py
recursive-include tools *.py
recursive-include assets *
recursive-include examples *
recursive-include benchmarks *
include .claude-plugin/plugin.json .codex-plugin/plugin.json
include .github/workflows/ci.yml
