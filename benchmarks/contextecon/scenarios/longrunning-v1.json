{
  "scenario_id": "longrunning-v1",
  "description": "A long-running coding agent: an early instruction, a later explicit correction, a repository trying to overwrite a user preference, and forty turns of accumulated noise. Measures what each memory strategy costs per turn and whether the operative fact survives.",
  "history": [
    {"op": "observe", "dimension": "preferences.node.package_manager", "value": "npm",
