{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vyas-devgna/liwm-agent-framework/schemas/config.schema.json",
  "title": "LIWM configuration",
  "description": "User-controlled settings for a LIWM home directory. Everything here is optional; the defaults are what LIWM uses when the file is absent.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },

    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch. `LIWM off` sets this to false; nothing is consulted or learned while it is false."
    },
    "default_mode": {
      "enum": ["auto", "low", "medium", "high", "off"],
      "default": "auto"
    },
    "learning_enabled": { "type": "boolean", "default": true },
    "onboarding_offered": { "type": "boolean", "default": false },

    "privacy": {
      "type": "object",
      "properties": {
        "telemetry": {
          "const": "disabled",
          "description": "Not configurable. LIWM ships no telemetry (constitution C12)."
        },
        "store_free_text": {
          "type": "boolean",
          "default": false,
          "description": "When false, quotes and notes are omitted from events; only structured observations are kept."
        },
        "redact_exports_by_default": { "type": "boolean", "default": false }
      },
      "additionalProperties": true
    },

    "promotion_policy": {
      "type": "object",
      "description": "Overrides for liwm.scope.PromotionPolicy. Stricter values are always safe.",
      "properties": {
        "min_projects_for_domain": { "type": "integer", "minimum": 2 },
        "min_domains_for_global": { "type": "integer", "minimum": 2 },
        "min_sessions_for_domain": { "type": "integer", "minimum": 1 },
        "min_sessions_for_global": { "type": "integer", "minimum": 2 },
        "min_source_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "domain_discount": { "type": "number", "minimum": 0, "maximum": 1 },
        "global_discount": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },

    "questioning": {
      "type": "object",
      "properties": {
        "max_questions_per_session": { "type": "integer", "minimum": 0, "maximum": 30 },
        "never_ask_about": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Dimensions the user does not want probed, ever."
        }
      },
      "additionalProperties": true
    },

    "retention": {
      "type": "object",
      "properties": {
        "backup_count": { "type": "integer", "minimum": 1, "default": 60 },
        "episode_retention_days": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },

    "hosts": {
      "type": "object",
      "description": "Recorded by the installer so update/uninstall know what was touched.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "installed": { "type": "boolean" },
          "skills_path": { "type": "string" },
          "bootstrap_file": { "type": "string" },
          "installed_at": { "type": "string" },
          "liwm_version": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
