{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vyas-devgna/liwm-agent-framework/schemas/user.schema.json",
  "title": "LIWM user profile",
  "description": "Materialised model of one human, folded deterministically from the append-only event log. Never hand-edited by the learning system; always reproducible with `liwm rebuild`.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "created_at",
    "updated_at",
    "beliefs"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "profile_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "constitution_hash": { "type": "string" },
    "last_rebuild": { "type": "object" },

    "materialized_from": {
      "type": "object",
      "description": "Provenance of this materialised view.",
      "properties": {
        "event_count": { "type": "integer", "minimum": 0 },
        "quarantined_event_count": { "type": "integer", "minimum": 0 },
        "last_event_id": { "type": ["string", "null"] },
        "last_event_ts": { "type": ["string", "null"] },
        "fold_hash": { "type": ["string", "null"] },
        "as_of": { "type": ["string", "null"] },
        "folded_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },

    "onboarding": {
      "type": "object",
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "completed", "declined"] },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "questions_asked": { "type": "integer", "minimum": 0, "maximum": 50 },
        "dimensions_covered": { "type": "array", "items": { "type": "string" } },
        "summary_shown": { "type": ["string", "null"] },
        "user_corrections": { "type": "array" },
        "confidence_basis": { "type": "string" }
      },
      "additionalProperties": true
    },

    "beliefs": {
      "type": "array",
      "description": "The canonical evidence-backed store. Every named section below is a projection of this list.",
      "items": { "$ref": "#/$defs/belief" }
    },

    "interaction_profile": { "$ref": "#/$defs/dimensionSection" },
    "reasoning_profile": { "$ref": "#/$defs/dimensionSection" },
    "creative_profile": { "$ref": "#/$defs/dimensionSection" },
    "domain_fluency": { "$ref": "#/$defs/dimensionSection" },
    "working_style": { "$ref": "#/$defs/dimensionSection" },
    "decision_style": { "$ref": "#/$defs/dimensionSection" },
    "communication_profile": { "$ref": "#/$defs/dimensionSection" },

    "persistent_goals": { "$ref": "#/$defs/listSection" },
    "persistent_anti_goals": { "$ref": "#/$defs/listSection" },
    "preferences": { "$ref": "#/$defs/listSection" },
    "anti_preferences": { "$ref": "#/$defs/listSection" },
    "learned_expectations": { "$ref": "#/$defs/listSection" },

    "cross_domain_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_domain", "target_domain", "dimension", "confidence", "status"],
        "properties": {
          "kind": { "const": "cross_domain_hypothesis" },
          "source_domain": { "type": ["string", "null"] },
          "target_domain": { "type": "string" },
          "dimension": { "type": "string" },
          "value": {},
          "confidence": { "type": "number", "minimum": 0, "maximum": 0.35 },
          "status": { "const": "hypothesis" },
          "requires": { "type": "string" },
          "source_belief_id": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },

    "uncertainties": { "type": "array" },
    "contradictions": { "type": "array", "items": { "$ref": "#/$defs/contradiction" } },
    "rejections": { "type": "array", "items": { "$ref": "#/$defs/rejection" } },
    "domains_seen": { "type": "array", "items": { "type": "string" } },
    "projects_seen": { "type": "array", "items": { "type": "string" } },

    "confidence_calibration": { "type": "object" },

    "privacy": {
      "type": "object",
      "properties": {
        "telemetry": { "const": "disabled" },
        "storage": { "const": "local_only" },
        "sensitive_attribute_inference": { "const": "refused" },
        "refusals_recorded": { "type": "integer", "minimum": 0 },
        "export_count": { "type": "integer", "minimum": 0 },
        "last_export": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },

    "statistics_summary": { "type": "object" }
  },

  "$defs": {
    "scope": { "enum": ["global", "domain", "project", "session"] },

    "sourceType": {
      "enum": [
        "explicit_statement", "explicit_correction", "explicit_rejection",
        "direct_edit", "repeated_selection", "comparative_choice",
        "onboarding_answer", "repeated_behavioral", "outcome_signal",
        "single_behavioral", "agent_inference", "promotion"
      ]
    },

    "provenance": {
      "enum": [
        "direct_user_message", "direct_user_edit", "explicit_user_review",
        "onboarding_answer", "agent_inference", "tool_output",
        "repository_content", "external_document", "web_content",
        "mcp_result", "subagent_report", "synthetic_test", "other", "derived"
      ]
    },

    "belief": {
      "type": "object",
      "required": ["id", "scope", "dimension", "value", "confidence", "status"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^blf_" },
        "key": { "type": "string" },
        "scope": { "$ref": "#/$defs/scope" },
        "scope_key": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "dimension": { "type": "string", "minLength": 1 },
        "value": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "contradiction_count": { "type": "integer", "minimum": 0 },
        "support_weight": { "type": "number", "minimum": 0 },
        "oppose_weight": { "type": "number", "minimum": 0 },
        "first_seen": { "type": "string" },
        "last_seen": { "type": "string" },
        "source_types": { "type": "array", "items": { "$ref": "#/$defs/sourceType" } },
        "provenance_types": { "type": "array", "items": { "$ref": "#/$defs/provenance" } },
        "decay_policy": { "enum": ["none", "slow", "standard", "volatile", "session"] },
        "session_ids": { "type": "array", "items": { "type": ["string", "null"] } },
        "evidence_refs": { "type": "array", "items": { "type": ["string", "null"] } },
        "origin": { "enum": ["observed", "promoted", "imported"] },
        "promoted_from": { "type": "array", "items": { "type": "string" } },
        "promotion_reason": { "type": "string" },
        "promotion_policy": { "type": "string" },
        "status": { "enum": ["active", "superseded", "rejected", "retired"] },
        "rejected_by_user": { "type": "boolean" },
        "suppressed_evidence": { "type": "integer", "minimum": 0 },
        "ceiling": { "type": "number", "minimum": 0, "maximum": 1 },
        "limiting_factor": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "rejection": { "type": ["object", "null"] }
      }
    },

    "dimensionEntry": {
      "type": "object",
      "required": ["value", "confidence", "scope"],
      "additionalProperties": true,
      "properties": {
        "value": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "scope_key": { "type": ["string", "null"] },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "contradiction_count": { "type": "integer", "minimum": 0 },
        "first_seen": { "type": "string" },
        "last_seen": { "type": "string" },
        "source_types": { "type": "array", "items": { "$ref": "#/$defs/sourceType" } },
        "origin": { "type": "string" },
        "belief_id": { "type": "string" },
        "alternatives": { "type": "array" }
      }
    },

    "dimensionSection": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/dimensionEntry" }
    },

    "listSection": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "confidence"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "value": {},
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "scope": { "$ref": "#/$defs/scope" },
          "scope_key": { "type": ["string", "null"] },
          "belief_id": { "type": "string" }
        }
      }
    },

    "contradiction": {
      "type": "object",
      "required": ["dimension", "type", "candidates"],
      "additionalProperties": true,
      "properties": {
        "dimension": { "type": "string" },
        "type": { "enum": ["same_scope_conflict", "cross_scope_tension"] },
        "severity": { "type": "number", "minimum": 0, "maximum": 1 },
        "resolvable_by_scope": { "type": "boolean" },
        "candidates": { "type": "array", "minItems": 2 },
        "suggested_resolution": { "type": "string" }
      }
    },

    "rejection": {
      "type": "object",
      "required": ["dimension", "rejected_at"],
      "additionalProperties": true,
      "properties": {
        "dimension": { "type": "string" },
        "value": {},
        "rejected_at": { "type": "string" },
        "reason": { "type": ["string", "null"] },
        "inference_source": { "type": ["string", "null"] },
        "scope": { "$ref": "#/$defs/scope" },
        "scope_key": { "type": ["string", "null"] }
      }
    }
  }
}
